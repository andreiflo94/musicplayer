CREATE TABLE Playlist (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL
);

CREATE TABLE PlaylistTrack (
    playlist_id INTEGER NOT NULL,
    track_name TEXT NOT NULL,
    path TEXT NOT NULL,
    art_path TEXT,
    PRIMARY KEY (playlist_id, path), -- A track can be in many playlists, but only once per playlist
    FOREIGN KEY (playlist_id) REFERENCES Playlist(id) ON DELETE CASCADE
);

-- Playlist Queries
insertPlaylist:
INSERT INTO Playlist (name) VALUES (?);

selectAllPlaylists:
SELECT * FROM Playlist;

selectPlaylistById:
SELECT * FROM Playlist WHERE id = ?;

deletePlaylistById:
DELETE FROM Playlist WHERE id = ?;

-- Custom Query to Get the Last Inserted Playlist ID
selectLastInsertedPlaylistId:
SELECT last_insert_rowid();

-- PlaylistTrack Queries
insertTrack:
INSERT OR IGNORE INTO PlaylistTrack (playlist_id, track_name, path, art_path) VALUES (?, ?, ?,?);

-- In the order they were added; without ORDER BY, SQLite walks the (playlist_id, path) key and
-- returns them sorted by path
selectTracksByPlaylistId:
SELECT * FROM PlaylistTrack WHERE playlist_id = ? ORDER BY rowid;

deleteTrackById:
DELETE FROM PlaylistTrack WHERE playlist_id = ? AND path = ?;

-- Check if track exists in playlist
trackExistsInPlaylist:
SELECT EXISTS(SELECT 1 FROM PlaylistTrack WHERE playlist_id = ? AND path = ?);